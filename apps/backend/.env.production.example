# ===========================================================================
# MedBridge — PRODUCTION environment template (Render API service)
# Copy the variables you need into Render → medbridge-api → Environment.
# Dev file lives at apps/backend/.env (git-ignored); NEVER commit real secrets.
# ===========================================================================

# --- Database (Neon free tier recommended — persistent; Render's free
#     Postgres deletes data after 30 days) -----------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/medbridge?sslmode=require"

# --- Server ----------------------------------------------------------------
PORT=4000
# EXACT frontend origin, no trailing slash — used for CORS:
CLIENT_ORIGIN="https://medbridge.vercel.app"
NODE_ENV=production

# --- Auth -------------------------------------------------------------------
# Generate: openssl rand -hex 32   (server refuses to boot in production
# without a strong secret)
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- ML service (auto-wired by render.yaml; manual value for other hosts) ---
ML_SERVICE_URL="https://medbridge-ml-xxxx.onrender.com"

# --- AdminJS panel (/admin) -------------------------------------------------
# All three required. On Render, ADMIN_PASSWORD/ADMIN_SESSION_SECRET are
# auto-generated — read them in the Environment panel.
ADMIN_EMAIL="admin@medbridge.local"
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# --- AI assistant ------------------------------------------------------------
# Pick: openai | gemini | claude | groq | deepseek | openrouter | mock
# "mock" needs no key (uses a built-in provider + live inventory context).
# Free real answers: set LLM_PROVIDER=groq and paste a Groq console key.
LLM_PROVIDER="mock"
LLM_MODEL=""
LLM_TEMPERATURE="0.7"
LLM_MAX_TOKENS="2048"

# Provider keys (only the one matching LLM_PROVIDER is required):
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
CLAUDE_API_KEY=""
CLAUDE_MODEL="claude-3-haiku-20240307"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-70b-versatile"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Allow mock fallback when no key is configured (recommended: true for demo)
MOCK_LLM_ENABLED="true"

# ---------------------------------------------------------------------------
# FRONTEND (Vercel) — build-time env vars, set in Vercel → Settings → env:
#   VITE_API_URL=https://medbridge-api-xxxx.onrender.com/api
#   (unset = same-origin /api, used by the local dev server & Docker nginx)
#
# ML SERVICE (Render medbridge-ml) — no secrets needed; the build generates
#   the dataset and trains the model (MEDBRIDGE_DEMO_ONLY=1 profile).
# ---------------------------------------------------------------------------
