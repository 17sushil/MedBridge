# Copy this file to .env and fill in real values. Never commit .env.

# Neon or local PostgreSQL
# Neon example (use YOUR string from Neon dashboard):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medbridge"
# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Auth
JWT_SECRET="medbridge-dev-secret-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# MedBridge Python ML service (XGBoost FastAPI)
# Start with: cd apps/ml-service && python -m uvicorn app.api.server:app --port 8000
ML_SERVICE_URL="http://localhost:8000"