# Copy this file to .env and fill in real values. Never commit .env.

# Neon or local PostgreSQL
# Neon example (use YOUR string from Neon dashboard):

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Auth
JWT_SECRET="medbridge-dev-secret-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# MedBridge Python ML service (XGBoost FastAPI)
# Start with: cd apps/ml-service && python -m uvicorn app.api.server:app --port 8000
ML_SERVICE_URL="http://localhost:8000"

# --- MedBridge Admin Panel (AdminJS) ---
# Required for /admin route - from Samir branch
ADMIN_EMAIL="admin@medbridge.local"
ADMIN_PASSWORD="Admin@2026"
ADMIN_SESSION_SECRET="medbridge-admin-secret-change-in-production-2026"

# --- MedBridge AI Assistant LLM Configuration ---
# Choose one provider: openai, gemini, claude, groq, deepseek, openrouter, mock
LLM_PROVIDER="openrouter"
# General LLM settings
LLM_MODEL="" 
LLM_TEMPERATURE="0.7"
LLM_MAX_TOKENS="2048"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Anthropic Claude
CLAUDE_API_KEY=""
CLAUDE_MODEL="claude-3-haiku-20240307"

# Groq (fast inference)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-70b-versatile"

# DeepSeek
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# OpenRouter ( unified gateway - Recommended for easy switching )
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Mock provider (used when no API key is configured - for development)
MOCK_LLM_ENABLED="true"
