// MedBridge database schema.
// Run `npm run prisma:migrate` after editing this file to apply changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum MedicineStatus {
  IN_STOCK
  LOW_STOCK
  MEDIUM_STOCK
  CRITICAL
}

enum ExchangeStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  DECLINED
}

enum NotificationType {
  CRITICAL
  EXCHANGE
  INFO
  SUCCESS
}

enum ReportType {
  INVENTORY
  EXCHANGE
  COMPLIANCE
}

model Hospital {
  id        String   @id @default(uuid())
  name      String
  location  String
  type      String // General, Specialty, Clinic
  rating    Float    @default(4.5)
  createdAt DateTime @default(now())

  users             User[]
  medicines         Medicine[]
  movements         InventoryMovement[]
  notifications     Notification[]
  reports           Report[]
  outgoingRequests  ExchangeRequest[] @relation("FromHospital")
  incomingRequests  ExchangeRequest[] @relation("ToHospital")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  avatarUrl    String?
  createdAt    DateTime @default(now())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
}

model Medicine {
  id        String         @id @default(uuid())
  name      String
  category  String
  batch     String
  quantity  Int
  unit      String // boxes, vials, etc.
  unitPrice Float          @default(0)
  expiry    DateTime
  status    MedicineStatus @default(IN_STOCK)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  movements  InventoryMovement[]

  @@index([hospitalId])
}

enum MovementType {
  IN
  OUT
}

model InventoryMovement {
  id         String       @id @default(uuid())
  type       MovementType
  quantity   Int
  occurredAt DateTime     @default(now())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([hospitalId])
  @@index([medicineId])
}

model ExchangeRequest {
  id          String         @id @default(uuid())
  medicine    String
  quantity    Int
  unit        String
  status      ExchangeStatus @default(PENDING)
  requestedOn DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  fromHospitalId String
  fromHospital   Hospital @relation("FromHospital", fields: [fromHospitalId], references: [id])

  toHospitalId String
  toHospital   Hospital @relation("ToHospital", fields: [toHospitalId], references: [id])

  @@index([fromHospitalId])
  @@index([toHospitalId])
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  body      String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
}

model Report {
  id          String     @id @default(uuid())
  name        String
  period      String
  type        ReportType
  generatedOn DateTime   @default(now())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@index([hospitalId])
}
